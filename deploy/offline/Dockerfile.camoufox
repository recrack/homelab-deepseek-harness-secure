ARG DSH_BASE_IMAGE=dsh-offline:local
FROM ${DSH_BASE_IMAGE}

ENV XDG_CACHE_HOME=/opt/camoufox/cache \
    CAMOUFOX_FPGEN_DATA=/opt/camoufox/fpgen

RUN mkdir -p /opt/camoufox/cache /opt/camoufox/fpgen \
    && /opt/homelab-dsh-plugins/packages/dsh-browser/node_modules/.bin/camoufox fetch \
    && rm -rf /opt/camoufox/cache/camoufox/geoip \
    && node /opt/homelab-dsh-plugins/packages/dsh-browser/scripts/prefetch-camoufox.mjs /opt/camoufox/browser-executable \
    && chmod -R a+rX /opt/camoufox

ENV XDG_CACHE_HOME=/state/home/.cache
